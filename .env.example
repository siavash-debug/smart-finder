# ─────────────────────────────────────────────────────────────────────────────
# smart-finder — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit it.
#
# SERVER-ONLY  : secrets. Must never appear in a NEXT_PUBLIC_* variable or reach
#                the browser bundle (MASTER_PROMPT §24).
# PUBLIC       : NEXT_PUBLIC_* only. Inlined into client JavaScript at build time.
#                Treat every value here as world-readable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────

# Execution environment. One of: development | test | production
NODE_ENV=development

# Log verbosity. One of: trace | debug | info | warn | error | fatal
LOG_LEVEL=info


# ── Database (SERVER-ONLY) ───────────────────────────────────────────────────

# PostgreSQL 16+ connection string. Required by both the web app and the worker.
# The default below matches infrastructure/docker/docker-compose.yml.
DATABASE_URL=postgresql://smartfinder:smartfinder@localhost:5432/smartfinder

# Maximum pooled connections per process. Keep the sum across all web instances
# and the worker below the server's max_connections.
DATABASE_POOL_MAX=10

# Milliseconds an idle pooled connection is kept before being closed.
DATABASE_IDLE_TIMEOUT_MS=30000

# Milliseconds to wait for a connection from the pool before failing.
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Require TLS for the database connection. Set to true for any managed/remote
# Postgres. Leave false for the local Docker instance.
DATABASE_SSL=false


# ── Web application ──────────────────────────────────────────────────────────

# Port the Next.js server listens on.
PORT=3000

# Public origin of the deployed web app, no trailing slash. Used to build
# absolute URLs (Telegram login callback, notification deep links).
APP_URL=http://localhost:3000


# ── Worker ───────────────────────────────────────────────────────────────────

# Port for the worker's own /healthz and /readyz endpoints.
WORKER_HEALTH_PORT=3001

# Jobs claimed per poll iteration.
WORKER_JOB_BATCH_SIZE=5

# Milliseconds to wait before polling again when the queue was empty.
WORKER_POLL_INTERVAL_MS=2000

# Grace period for in-flight jobs to finish after SIGTERM/SIGINT before exit.
WORKER_SHUTDOWN_TIMEOUT_MS=15000

# Cloudflare Browser Rendering (SERVER-ONLY, both optional, set together or not at all).
# When unset, the worker launches a local Chromium via Playwright — the default for local
# dev/CI, unchanged from Phase 5. When both are set, the Divar scraper's browser runs against
# Cloudflare Browser Rendering's real CDP endpoint instead (Stage 2 of the Browser Rendering
# migration; see docs/DECISIONS.md). Never commit real values.
# CLOUDFLARE_BROWSER_RENDERING_ACCOUNT_ID=
# CLOUDFLARE_BROWSER_RENDERING_API_TOKEN=

# Docker collector only (infrastructure/docker/Dockerfile.worker). Chromium refuses its own
# sandbox when run as root without the specific non-root user/permission setup Playwright's
# pre-built image configures — set to false only inside that container. Leave true (the
# default) everywhere else; this is a container-security-model setting, not a scraping-behavior
# or evasion setting, and has no effect on what a scraped site sees.
PLAYWRIGHT_CHROMIUM_SANDBOX=true


# ── Telegram (SERVER-ONLY) — required by both web and worker ─────────────────

# Bot token from @BotFather, shape "<digits>:<secret>". Used to call the Bot
# API (sendMessage, answerCallbackQuery) — never exposed to the browser.
# Required by: apps/web (webhook replies) and apps/worker (notification
# delivery).
TELEGRAM_BOT_TOKEN=

# Arbitrary secret you choose (1-256 chars, A-Z a-z 0-9 _ -) and configure as
# the `secret_token` when calling Telegram's setWebhook. The webhook route
# rejects any request whose X-Telegram-Bot-Api-Secret-Token header doesn't
# match this exactly. Required by: apps/web only — the worker never receives
# inbound webhook requests.
TELEGRAM_WEBHOOK_SECRET=

# Bot username without the leading @. Not yet consumed (a future Telegram
# Login Widget on the web app would need it); safe to leave unset for now.
# TELEGRAM_BOT_USERNAME=


# ── AI provider (SERVER-ONLY) — Phase 7, not yet consumed ────────────────────

# ANTHROPIC_API_KEY=

# Hard ceiling on estimated AI spend per UTC day, in US cents. When the running
# total crosses this, AI calls stop and deterministic fallback is used.
# AI_DAILY_BUDGET_CENTS=500


# ── Public (browser-readable) ────────────────────────────────────────────────

# Origin used by client-side code. Safe to expose — contains no secret.
NEXT_PUBLIC_APP_URL=http://localhost:3000
